# Vaultwright — environment template.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# Telegram bot token — create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank at first — message the bot once and it replies with your ID.
TELEGRAM_ALLOWED_IDS=

# LLM API key used for intent classification.
ANTHROPIC_API_KEY=

# Optional — override the classifier model (a small, fast model is plenty).
VAULTWRIGHT_MODEL=claude-haiku-4-5-20251001
