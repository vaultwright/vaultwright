<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vaultwright weekly digest (USE_CASES UC-7).
     __VAULTWRIGHT_HOME__ is substituted by scripts/install_jobs.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaultwright.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__VAULTWRIGHT_HOME__/scripts/run.sh</string>
    <string>digest</string>
  </array>

  <!-- Weekly: Mondays at 08:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__VAULTWRIGHT_HOME__/logs/digest.log</string>
  <key>StandardErrorPath</key>
  <string>__VAULTWRIGHT_HOME__/logs/digest.log</string>
</dict>
</plist>
