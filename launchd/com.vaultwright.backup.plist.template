<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vaultwright vault git autosave (USE_CASES UC-8).
     __VAULTWRIGHT_HOME__ is substituted by scripts/install_jobs.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaultwright.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__VAULTWRIGHT_HOME__/scripts/git_autocommit.sh</string>
  </array>

  <!-- Hourly -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>__VAULTWRIGHT_HOME__/logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>__VAULTWRIGHT_HOME__/logs/backup.log</string>
</dict>
</plist>
